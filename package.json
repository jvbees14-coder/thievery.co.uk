{
  "name": "thievery-co-uk",
  "version": "1.0.0",
  "private": true,
  "description": "Thievery.co.uk: the partnership deduction card game, playable online with room codes.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "r2:check": "node scripts/r2-check.js",
    "decks:import": "node scripts/decks-import.js",
    "decks:check": "node scripts/decks-check.js",
    "decks:topics": "node scripts/decks-topics.js",
    "decks:topics:claude": "node scripts/decks-topics-claude.js",
    "test": "node test/source.test.js && node test/smoke.test.js && node test/powerups.test.js && node test/site.test.js && node test/battle.test.js && node test/switchhead.test.js && node test/flashcards.test.js && node test/mindmaps.test.js && node test/r2.test.js",
    "test:game": "node test/smoke.test.js",
    "test:powerups": "node test/powerups.test.js",
    "test:site": "node test/site.test.js",
    "test:battle": "node test/battle.test.js",
    "test:switchhead": "node test/switchhead.test.js",
    "test:flashcards": "node test/flashcards.test.js",
    "test:mindmaps": "node test/mindmaps.test.js",
    "test:r2": "node test/r2.test.js",
    "test:source": "node test/source.test.js",
    "icons": "node scripts/make-icons.js",
    "fonts": "node scripts/fetch-fonts.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "ws": "^8.18.0"
  }
}
